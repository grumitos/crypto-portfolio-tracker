{
  "name": "crypto-portfolio-tracker",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.0",
  "type": "module",
  "imports": {
    "#test": "./src/test/bun-test.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development PUBLIC_APP_ENV=development bun --hot src/server.ts",
    "build": "NODE_ENV=production PUBLIC_APP_ENV=production bun build --target=bun --production --outdir=dist '--env=PUBLIC_*' src/server.ts",
    "preview": "NODE_ENV=production PUBLIC_APP_ENV=production bun dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate --watch",
    "test:run": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "eth:analysis": "python scripts/eth_analysis_runner.py",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "check:ci": "pnpm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@types/jsdom": "^28.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0"
  }
}
